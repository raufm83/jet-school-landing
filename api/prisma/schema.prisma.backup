datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  firstName Json?     // { az?: string, ru?: string } — müəllif üçün dillər üzrə ad
  lastName  Json?     // { az?: string, ru?: string } — müəllif üçün dillər üzrə soyad
  email     String    @unique
  password  String
  role      Role      @default(USER)
  profile   Profile?
  sessions      Session[]
  posts         Post[]
  glossaryTerms Glossary[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Profile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  avatarUrl   String?
  location    String?
  profession  Json?    // { az?: string, ru?: string } — müəllif üçün dillər üzrə ixtisas
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Request {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  surname        String
  number         String
  childAge       Int
  childLanguage  Language      @default(AZ)
  message        String?
  additionalInfo Json?
  createdAt      DateTime      @default(now())
  status         RequestStatus @default(PENDING)
  viewedBy       String?
  viewedAt       DateTime?
}

model BlogCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// { "az": string, "ru": string }
  name      Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("BlogCategory")
}

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     Json
  content   Json
  slug      SlugI18n
  published Boolean  @default(false)
  imageUrl  Json?    // { az?: string, ru?: string } — hero image per locale
  imageAlt  Json?    // SEO alt text: { az?, ru? }
  tags      Json[]
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id])
  postType  PostType @default(BLOG)

  blogCategoryId String?       @db.ObjectId
  blogCategory   BlogCategory? @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)

  eventDate   DateTime?
  eventStatus EventStatus?

  offerStartDate DateTime?
  offerEndDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug], name: "uniqueMultilingualSlug")
  @@index([authorId])
  @@index([postType])
  @@index([eventStatus])
  @@index([blogCategoryId])
}

model StudentProjectsCategory {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  /// UTF-8 mətn, və ya { "az", "ru" } — Mongo BSON uyğunluğu üçün Json
  name      Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  projects  StudentProjects[]
}

model StudentProjects {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  title       Json?
  description Json?
  imageUrl    String
  link        String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  categoryId  String                  @db.ObjectId
  category    StudentProjectsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order       Int

  @@index([categoryId])
}

model StudentReview {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       Json?    // { az, ru } — same as projects
  description Json?    // { az, ru }
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  link        String?  // YouTube URL
  imageUrl    String?  // YouTube thumbnail (computed)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

model Team {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            MultilingualText
  surname         MultilingualText
  fullName        MultilingualText
  imageUrl        String
  createdAt       DateTime          @default(now())
  bio             Json?
  order           Int
  isActive        Boolean           @default(true)
  coursesTeaching CourseToTeacher[]
}

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String
  title     Json?
  imageAlt  Json?    // SEO alt text: { az, ru }
  createdAt DateTime @default(now())
  order     Int      @default(0)
}

model ContactInfo {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String
  address      Json?
  address2     Json?
  whatsapp     Json?
  phone        Json?
  workingHours Json?
  socialLinks  Json?    // { facebook?, instagram?, youtube?, tiktok? }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Ana səhifə hero bölməsi (tək sənəd; mətn HTML redaktoru ilə — AZ/RU)
model HomeHero {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  bodyHtml  MultilingualText?
  imageUrl  String
  imageAlt  MultilingualText?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

/// Haqqimizda sehifesinin giris (intro/hero) bolmesi - tek sened
model AboutHero {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  bodyHtml  MultilingualText?
  imageUrl  String
  imageAlt  MultilingualText?
  missionVision Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Course {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  title            Json
  description      Json
  shortDescription Json?
  slug             SlugI18n
  icon             String                @default("FaStar")
  duration         Int
  level            Json
  published        Boolean               @default(false)
  modules          CourseToModule[]
  teachers         CourseToTeacher[]
  eligibility      CourseToEligibility[]
  tag              String[]
  newTags          Json?
  imageUrl         String?
  ageRange         String?
  backgroundColor  String?               @default("#FEF3C7")
  borderColor      String?               @default("#F59E0B")
  textColor        String?               @default("#1F2937")
  order            Int                   @default(0)
  studentReviews   StudentReview[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([slug], name: "uniqueMultilingualCourseSlug")
}

model CourseModule {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       Json
  description Json?
  content     Json
  courses     CourseToModule[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CourseToModule {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String       @db.ObjectId
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId  String       @db.ObjectId
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime     @default(now())

  @@unique([courseId, moduleId])
  @@index([courseId])
  @@index([moduleId])
}

model CourseTeacher {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description Json?
  courses     CourseToTeacher[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CourseToTeacher {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  position        String?
  courseId        String        @db.ObjectId
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId       String        @db.ObjectId
  teacher         Team          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseTeacherId String        @db.ObjectId
  courseTeacher   CourseTeacher @relation(fields: [courseTeacherId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([courseId, teacherId, courseTeacherId])
  @@index([courseId])
  @@index([teacherId])
  @@index([courseTeacherId])
}

model CourseEligibility {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  title       Json
  description Json
  icon        String
  courses     CourseToEligibility[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CourseToEligibility {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  courseId      String            @db.ObjectId
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  eligibilityId String            @db.ObjectId
  eligibility   CourseEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Cascade)
  order         Int               @default(0)
  createdAt     DateTime          @default(now())

  @@unique([courseId, eligibilityId])
  @@index([courseId])
  @@index([eligibilityId])
}

enum Language {
  AZ
  RU
}

enum Role {
  USER
  AUTHOR
  CRMOPERATOR
  CONTENTMANAGER
  COORDINATOR
  HRMANAGER
  STAFF
  ADMIN
}

enum RequestStatus {
  VIEWED
  PENDING
}

enum PostType {
  BLOG
  NEWS
  EVENT
  OFFERS
}

enum EventStatus {
  ONGOING
  UPCOMING
  PAST
}

type SlugI18n {
  az String
  ru String
}

model Glossary {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  term         MultilingualText
  definition   MultilingualText
  slug         SlugI18n
  category     GlossaryCategory? @relation(fields: [categoryId], references: [id])
  categoryId   String?           @db.ObjectId
  authorId     String?           @db.ObjectId
  author       User?             @relation(fields: [authorId], references: [id])
  published    Boolean           @default(false)
  relatedTerms String[]          @db.ObjectId
  tags         MultilingualText[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([slug], name: "uniqueMultilingualGlossarySlug")
  @@index([categoryId])
  @@index([authorId])
  @@index([tags])
}

model GlossaryCategory {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  name          MultilingualText
  description   MultilingualText?
  slug         SlugI18n
  glossaryTerms Glossary[]
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([slug], name: "uniqueMultilingualGlossaryCategorySlug")
}

type MultilingualText {
  az String
  ru String
}

model PageMeta {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pageKey     String   // e.g. "courses", "about-us", "contact-us", "course:slug"
  locale      String   // "az" | "ru"
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageKey, locale], name: "uniquePageMetaKeyLocale")
  @@index([pageKey])
  @@index([locale])
}

model PageSchema {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pageKey    String   // e.g. "home", "courses", "about-us", "course:slug"
  locale     String   // "az" | "ru"
  schemaJson Json     // JSON-LD object or array of objects
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, locale], name: "uniquePageSchemaKeyLocale")
  @@index([pageKey])
  @@index([locale])
}

/// Admin panel FAQ (hələlik yalnız idarə panelində; sayt frontunda endpoint yoxdur)
model FaqItem {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  question  MultilingualText
  answer    MultilingualText
  order     Int              @default(0)
  /// @deprecated Bir FAQ bir neçə səhifəyə aid ola bilər — `pages` istifadə edin
  page      String?
  /// Səhifə açarları: "home", "about", "courses", "course:slug", ...
  pages     String[]         @default([])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([order])
  @@index([page])
}

model Vacancy {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       MultilingualText
  description MultilingualText
  requirements MultilingualText?
  /// İş şəraiti — HTML (ReactQuill ilə doldurulur). Hər iki dil üçün.
  workConditions MultilingualText?
  /// { az: string[], ru: string[] } — kartda taglar
  tags        Json?
  slug        SlugI18n
  /// Son müraciət tarixi (kart və detalda göstərilir)
  deadline         DateTime?
  /// FULL_TIME | PART_TIME | REMOTE | FREELANCE
  employmentType   String?
  /// NONE | Y1 | Y1_3 | Y3_5 | Y5_PLUS
  experienceLevel  String?
  isActive    Boolean          @default(true)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([slug], name: "uniqueVacancySlug")
  @@index([isActive])
  @@index([order])
}
